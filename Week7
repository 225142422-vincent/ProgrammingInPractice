
#include <stdio.h>
#include <string.h>

#define MAX_SUPPLIERS 5

char supplierNames[MAX_SUPPLIERS][100];
char supplierEmails[MAX_SUPPLIERS][100];
char supplierPhones[MAX_SUPPLIERS][30];
char supplierTowns[MAX_SUPPLIERS][50];

int supplierCount = 0;

void addSupplier();
void displaySuppliers();
void searchSupplier();
void showNameLength();
void copySupplierName();
void createSupplierDescription();
void displayMenu();

int main() {
    int choice;

    do {
        displayMenu();
        scanf("%d", &choice);
        getchar();

        switch (choice) {
            case 1:
                addSupplier();
                break;

            case 2:
                displaySuppliers();
                break;

            case 3:
                searchSupplier();
                break;

            case 4:
                showNameLength();
                break;

            case 5:
                copySupplierName();
                break;

            case 6:
                createSupplierDescription();
                break;

            case 7:
                printf("\nThank you for using Supplier Management System.\n");
                break;

            default:
                printf("\nInvalid choice. Please try again.\n");
        }

    } while (choice != 7);

    return 0;
}

void displayMenu() {
    printf("\n========================================\n");
    printf("       MUNICIPAL FINANCIAL MANAGEMENT\n");
    printf("          SUPPLIER MANAGEMENT\n");
    printf("========================================\n");
    printf("1. Add Supplier\n");
    printf("2. Display Suppliers\n");
    printf("3. Search Supplier\n");
    printf("4. Show Supplier Name Length\n");
    printf("5. Copy Supplier Name\n");
    printf("6. Create Supplier Description\n");
    printf("7. Exit\n");
    printf("----------------------------------------\n");
    printf("Enter choice: ");
}

void addSupplier() {
    if (supplierCount >= MAX_SUPPLIERS) {
        printf("\nMaximum of five suppliers reached.\n");
        return;
    }

    printf("\nEnter supplier name: ");
    fgets(supplierNames[supplierCount], 100, stdin);
    supplierNames[supplierCount][strcspn(supplierNames[supplierCount], "\n")] = '\0';

    printf("Enter supplier email: ");
    fgets(supplierEmails[supplierCount], 100, stdin);
    supplierEmails[supplierCount][strcspn(supplierEmails[supplierCount], "\n")] = '\0';

    printf("Enter supplier phone: ");
    fgets(supplierPhones[supplierCount], 30, stdin);
    supplierPhones[supplierCount][strcspn(supplierPhones[supplierCount], "\n")] = '\0';

    printf("Enter supplier town: ");
    fgets(supplierTowns[supplierCount], 50, stdin);
    supplierTowns[supplierCount][strcspn(supplierTowns[supplierCount], "\n")] = '\0';

    supplierCount++;

    printf("\nSupplier added successfully!\n");
}

void displaySuppliers() {
    if (supplierCount == 0) {
        printf("\nNo suppliers have been added yet.\n");
        return;
    }

    printf("\n========== SUPPLIER DETAILS ==========\n");

    for (int i = 0; i < supplierCount; i++) {
        printf("\nSupplier %d\n", i + 1);
        printf("Name : %s\n", supplierNames[i]);
        printf("Email: %s\n", supplierEmails[i]);
        printf("Phone: %s\n", supplierPhones[i]);
        printf("Town : %s\n", supplierTowns[i]);
    }
}

void searchSupplier() {
    char searchName[100];
    int found = 0;

    if (supplierCount == 0) {
        printf("\nNo suppliers available to search.\n");
        return;
    }

    printf("\nEnter supplier name to search: ");
    fgets(searchName, sizeof(searchName), stdin);
    searchName[strcspn(searchName, "\n")] = '\0';

    for (int i = 0; i < supplierCount; i++) {
        if (strcmp(supplierNames[i], searchName) == 0) {
            printf("\nSupplier found!\n");
            printf("Name : %s\n", supplierNames[i]);
            printf("Email: %s\n", supplierEmails[i]);
            printf("Phone: %s\n", supplierPhones[i]);
            printf("Town : %s\n", supplierTowns[i]);

            found = 1;
            break;
        }
    }

    if (!found) {
        printf("\nSupplier not found.\n");
    }
}

void showNameLength() {
    if (supplierCount == 0) {
        printf("\nNo suppliers available.\n");
        return;
    }

    for (int i = 0; i < supplierCount; i++) {
        printf("\nSupplier: %s\n", supplierNames[i]);
        printf("Name length: %zu characters\n",
               strlen(supplierNames[i]));
        printf("Email length: %zu characters\n",
               strlen(supplierEmails[i]));
        printf("Town length: %zu characters\n",
               strlen(supplierTowns[i]));
    }
}

void copySupplierName() {
    char backup[100];

    if (supplierCount == 0) {
        printf("\nNo supplier name available to copy.\n");
        return;
    }

    strcpy(backup, supplierNames[0]);

    printf("\nOriginal supplier name: %s\n", supplierNames[0]);
    printf("Copied supplier name: %s\n", backup);
}

void createSupplierDescription() {
    char description[250] = "";
    char sentence[] = " operates in ";
    char ending[] = ".";

    if (supplierCount == 0) {
        printf("\nNo supplier information available.\n");
        return;
    }

    strcpy(description, supplierNames[0]);
    strcat(description, sentence);
    strcat(description, supplierTowns[0]);
    strcat(description, ending);

    printf("\nSupplier Description:\n");
    printf("%s\n", description);
}
